MAXVM=223264
# MAXMM: maximum memory used in KiB
MAXMM=47596
# MAXRSS: maximum Resident Segment Size in KiB
MAXRSS=48784
# TIMEOUT: did the solver exceed the time limit?
TIMEOUT=false
# MEMOUT: did the solver exceed the memory limit?
MEMOUT=false
