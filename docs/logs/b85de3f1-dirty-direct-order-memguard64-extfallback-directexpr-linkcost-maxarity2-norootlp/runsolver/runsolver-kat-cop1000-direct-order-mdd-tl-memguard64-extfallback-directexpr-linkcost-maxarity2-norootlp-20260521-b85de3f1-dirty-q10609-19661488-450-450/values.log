SYSTEMTIME=0.169324
# CPUUSAGE: CPUTIME/WCTIME in percent
CPUUSAGE=98.3671
# MAXVM: maximum virtual memory used in KiB
MAXVM=439176
# MAXMM: maximum memory used in KiB
MAXMM=214468
# MAXRSS: maximum Resident Segment Size in KiB
MAXRSS=221260
